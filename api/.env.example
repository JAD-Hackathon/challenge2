POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
DB_ECHO=false

# true = catalogue in memory (app/mocks), no database needed. ML is still called for uploads
API_MOCK=false

ML_SERVICE_URL=http://localhost:8001
ML_TIMEOUT_S=120
SHARED_DIR=../data

MAX_BATCH_SIZE=20
MAX_VIDEO_MB=1024
# Frames per video, each one an ML /infer call (one every spacing_m metres)
MAX_VIDEO_FRAMES=300
# Prefix of image URLs in responses (absolute if the browser needs it, path must stay /media)
MEDIA_URL=/media
