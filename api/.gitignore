build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# --- Testing & coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# --- Type checkers / linters ---
.mypy_cache/
.ruff_cache/
